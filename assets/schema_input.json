{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/test/test/master/assets/schema_input.json",
    "title": "Test schema for samplesheets",
    "description": "Schema for the file provided with params.data_input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "description": "Sample identifier for the dataset.",
                "errorMessage": "Identifier for a dataset must be provided and contain no spaces.",
                "pattern": "^\\S+$",
                "meta": "id"
            },
            "platform": {
                "type": "string",
                "description": "Sequencing platform .",
                "errorMessage": "Unique identifier for a dataset must be provided and contain no spaces.",
                "pattern": "^\\S+$",
                "meta": "platform",
                "enum": ["pacbio_hifi", "oxford_nanopore", "illumina_hic"]
            },
            "reads": {
                "type": "array",
                "description": "List of files containing the sequencing reads for the sample. Can be in FASTA, FASTQ or CRAM format.",
                "items": {
                    "type": "string",
                    "format": "file-path",
                    "pattern": "^\\S+\\.((fastq|fq|fasta|fna|fa)(\\.gz)?|cram)$",
                    "exists": true
                },
                "uniqueItems": true
            },
            "assembly": {
                "type": "string",
                "format": "file-path",
                "pattern": "^\\S+\\.(fa|fasta)(\\.gz)?",
                "exists": true
            },
            "assembler": {
                "type": "string",
                "description": "Name of the assembler used to produce the assembly.",
                "meta": "assembler"
            }
        },
        "required": ["id", "platform", "reads"],
        "dependentRequired": {
            "assembly": ["assembler"]
        },
        "uniqueEntries": ["id", "platform"]
    }
}
