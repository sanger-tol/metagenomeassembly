nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    profile "test"

    test("test multisample input") {

        setup {
            print "\n\n\t"
            curlAndExtract("https://tolit.cog.sanger.ac.uk/test-data/resources/gtdbtk/gtdbtk_mockup_r232.tar.gz", "${launchDir}/")
        }

        when {
            params {
                input = "${projectDir}/assets/test_input_multisample.yaml"
                outdir = "$outputDir"

                // binners
                extract_circular_contigs  = false
                enable_metabat2           = true
                enable_maxbin2            = false
                enable_metator            = false
                enable_comebin            = false
                enable_semibin2           = true
                enable_vamb               = true
                enable_taxvamb            = false
                enable_dastool            = false
                enable_binette            = false

                // databases
                gtdbtk_db            = "${launchDir}/release232_mockup"
            }
        }

        then {
            // We are going to write some funky assertions as we cannot expect that any output (files or counts) are stable
            // Stable file names
            def assembly_files = getAllFilesFromDir(
                "${params.outdir}/",
                relative: true,
                includeDir: true,
                ignore: [
                    "**/*.assembly_primary_annotate/**",
                    "**/*.assembly_primary_find_proviruses/**",
                    "**/*.assembly_primary_marker_classification/**",
                    "**/*.assembly_primary_nn_classification/**",
                    "**/*.assembly_primary_aggregated_classification/**",
                ]
            )
            def bin_files = getAllFilesFromDir(
                "${params.outdir}/",
                relative: true,
                ignore: [
                    "**/assembly/**",
                    "**/fasta/*.fa.gz"
                ]
            )

            def assembly_dirs = path("${params.outdir}/").listDirectory().findAll { it.isDirectory() }.collect { it.name }
            assembly_dirs.collect { asm ->
                // Unstable and uncountable files
                def bin_fasta = getAllFilesFromDir(
                    "${params.outdir}/${asm}/binning/",
                    relative: true,
                    includeDir: true,
                    include: [
                        "**/binning/bins/*/fasta/*.fa.gz"
                    ]
                )

                // Count number of GTDB-Tk-appropriate bins
                def n_gtdbtk_bins = path("${params.outdir}/${asm}/binning/${asm}_checkm2_report.tsv")
                    .csv(sep: "\t")
                    .rows.findAll { it.Completeness >= 50 && it.Contamination <= 10 }.size()

                assertAll(
                    // Check number of CheckM2 bins processed matches number of bins
                    { assert path("${params.outdir}/${asm}/binning/${asm}_checkm2_report.tsv").csv(sep: "\t").rowCount == bin_fasta.size() },

                    // Check bin_summary.tsv file has expected number of rows
                    { assert path("${params.outdir}/${asm}/binning/${asm}.bins_summary.tsv").csv(sep: "\t").rowCount == bin_fasta.size() },

                    // Check GTDB-Tk output has expected number of rows
                    { assert path("${params.outdir}/${asm}/binning/gtdbtk/${asm}/${asm}.bac120.summary.tsv").csv(sep: "\t").rowCount == n_gtdbtk_bins },

                    // Check group_summary.tsv file has expected number of rows
                    { assert path("${params.outdir}/${asm}/binning/${asm}.groups_summary.tsv").csv(sep: "\t").rowCount == 3 },
                )
            }

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/metagenomeassembly_software_versions.yml"),
                    assembly_files,
                    bin_files
                ).match() }
            )
        }

        cleanup {
            new File("${launchDir}/release232_mockup").deleteDir()
        }

    }
}
