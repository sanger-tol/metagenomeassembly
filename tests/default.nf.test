nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("single-sample test") {

        setup {
            print "\n\n\t"
            curlAndExtract("https://tolit.cog.sanger.ac.uk/test-data/resources/gtdbtk/gtdbtk_mockup_r232.tar.gz", "${launchDir}/")
            print "\t"
            curlAndExtract("https://tolit.cog.sanger.ac.uk/test-data/resources/metagenomeassembly/genomad_db_subset_v1.9.tar.gz", "${launchDir}/")
        }

        when {
            params {
                outdir               = "$outputDir"

                // binners
                extract_circular_contigs  = true
                enable_metabat2           = true
                enable_maxbin2            = true
                enable_metator            = true
                enable_comebin            = true
                enable_semibin2           = false
                enable_vamb               = false
                enable_taxvamb            = false
                enable_dastool            = true
                enable_binette            = true

                // databases
                gtdbtk_db            = "${launchDir}/release232_mockup"
                genomad_db           = "${launchDir}/genomad_db"
            }
        }

        then {
            // We are going to write some funky assertions as we cannot expect that any output (files or counts) are stable
            // Stable file names
            def assembly_files = getAllFilesFromDir(
                "${params.outdir}/assembly/",
                relative: true,
                includeDir: true,
                ignore: [
                    "**/*.assembly_primary_annotate/**",
                    "**/*.assembly_primary_find_proviruses/**",
                    "**/*.assembly_primary_marker_classification/**",
                    "**/*.assembly_primary_nn_classification/**",
                    "**/*.assembly_primary_aggregated_classification/**",
                    "**/myloasm/*.log"
                ]
            )
            def bin_files      = getAllFilesFromDir("${params.outdir}/binning/", relative: true, ignore: ["**/fasta/*.fa.gz"])

            // Unstable and uncountable files
            def bin_fasta      = getAllFilesFromDir("${params.outdir}/binning/bins/", relative: true, includeDir: true, include: ["**/fasta/*.fa.gz"])

            // Count number of GTDB-Tk-appropriate bins
            def n_gtdbtk_bins = path("${params.outdir}/binning/xyTesTing2_checkm2_report.tsv")
                .csv(sep: "\t")
                .rows.findAll { it.Completeness >= 50 && it.Contamination <= 10 }.size()

            assertAll(
                { assert workflow.success },
                // Unstable file checks
                // Check number of CheckM2 bins processed matches number of bins
                { assert path("${params.outdir}/binning/xyTesTing2_checkm2_report.tsv").csv(sep: "\t").rowCount == bin_fasta.size() },

                // Check bin_summary.tsv file has expected number of rows
                { assert path("${params.outdir}/binning/xyTesTing2.bins_summary.tsv").csv(sep: "\t").rowCount == bin_fasta.size() },

                // Check GTDB-Tk output has expected number of rows
                { assert path("${params.outdir}/binning/gtdbtk/xyTesTing2/xyTesTing2.bac120.summary.tsv").csv(sep: "\t").rowCount == n_gtdbtk_bins },

                // Check group_summary.tsv file has expected number of rows
                { assert path("${params.outdir}/binning/xyTesTing2.groups_summary.tsv").csv(sep: "\t").rowCount == 7 },

                // Check files with stable names
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/metagenomeassembly_software_versions.yml"),
                    assembly_files,
                    bin_files
                ).match() }
            )
        }

        cleanup {
            new File("${launchDir}/release232_mockup").deleteDir()
            new File("${launchDir}/genomad_db").deleteDir()
        }

    }
}
