nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    profile "test"

    test("-profile test") {

        setup {
            def gtdbtk_command = ['bash', '-c', "curl https://tolit.cog.sanger.ac.uk/test-data/resources/gtdbtk/mockup.tar.gz | tar xzf - -C ${launchDir}"]
            def gtdbtk_proc = gtdbtk_command.execute()
            gtdbtk_proc.waitFor()

            if (gtdbtk_proc.exitValue() != 0) {
                throw new RuntimeException("Error - failed to download GTDB-Tk mock db: ${gtdbtk_proc.err.text}")
            }

            def ncbi_command = ['bash', '-c', [
                "curl -L https://ftp.ncbi.nih.gov/pub/taxonomy/taxdump_archive/taxdmp_2025-06-01.zip --output ${launchDir}/taxdump.zip",
                "unzip ${launchDir}/taxdump.zip -d ${launchDir}/taxdump",
                "rm ${launchDir}/taxdump.zip"
            ].join(' && ')]
            def ncbi_proc = ncbi_command.execute()
            ncbi_proc.waitFor()

            if (ncbi_proc.exitValue() != 0) {
                throw new RuntimeException("Error - failed to download NCBI taxdump: ${ncbi_proc.err.text}")
            }
        }

        when {
            params {
                outdir = "$outputDir"
                gtdbtk_db = "${launchDir}/r226_mockup"
                ncbi_taxonomy_dir = "${launchDir}/taxdump"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_metagenomeassembly_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test_withassembly") {

        setup {
            def gtdbtk_command = ['bash', '-c', "curl https://tolit.cog.sanger.ac.uk/test-data/resources/gtdbtk/mockup.tar.gz | tar xzf - -C ${launchDir}"]
            def gtdbtk_proc = gtdbtk_command.execute()
            gtdbtk_proc.waitFor()

            if (gtdbtk_proc.exitValue() != 0) {
                throw new RuntimeException("Error - failed to download GTDB-Tk mock db: ${gtdbtk_proc.err.text}")
            }

            def ncbi_command = ['bash', '-c', [
                "curl -L https://ftp.ncbi.nih.gov/pub/taxonomy/taxdump_archive/taxdmp_2025-06-01.zip --output ${launchDir}/taxdump.zip",
                "unzip ${launchDir}/taxdump.zip -d ${launchDir}/taxdump",
                "rm ${launchDir}/taxdump.zip"
            ].join(' && ')]
            def ncbi_proc = ncbi_command.execute()
            ncbi_proc.waitFor()

            if (ncbi_proc.exitValue() != 0) {
                throw new RuntimeException("Error - failed to download NCBI taxdump: ${ncbi_proc.err.text}")
            }
        }

        when {
            params {
                outdir = "$outputDir"
                gtdbtk_db = "${launchDir}/r226_mockup"
                ncbi_taxonomy_dir = "${launchDir}/taxdump"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_metagenomeassembly_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }
}
