/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run sanger-tol/metagenomeassembly -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name            = 'Test profile'
    config_profile_description     = 'Minimal test dataset to check pipeline function'

    // Input data
    input                          = "${projectDir}/assets/test_input_single.yaml"
    genomad_splits                 = 8
    minimum_circular_contig_length = 100000
    hic_enzymes                    = "DpnII,HinfI"
    checkm2_db                     = "https://tolit.cog.sanger.ac.uk/test-data/resources/metagenomeassembly/checkm2_small_db.dmnd"
    gtdbtk_use_full_tree           = true
    gtdbtk_place_species           = true
}
