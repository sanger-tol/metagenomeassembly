/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run sanger-tol/metagenomeassembly -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name            = 'Test profile'
    config_profile_description     = 'Minimal test dataset to check pipeline function with multisplit binning'

    // Input data
    input                          = "${projectDir}/assets/test_input_multisample_withassembly.yaml"
    assembler                      = "metamdbg"
    tiara_exclude_classifications  = "eukarya,organelle"
    genomad_splits                 = 8
    checkm2_db                     = "https://tolit.cog.sanger.ac.uk/test-data/resources/metagenomeassembly/checkm2_small_db.dmnd"
    gtdbtk_use_full_tree           = true
    gtdbtk_place_species           = true

    // enable/disable binners
    enable_multisplit         = true
    extract_circular_contigs  = false
    enable_metabat2           = false
    enable_maxbin2            = false
    enable_metator            = false
    enable_comebin            = false
    enable_semibin2           = true
    enable_vamb               = true
    enable_taxvamb            = true
    enable_bin_refinement     = false
    enable_dastool            = false
    enable_binette            = false

}
